# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ==============================
# Anthropic (Claude) API
# ==============================
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model selection is configurable via environment variables and must never be
# hard-coded in application code. Defaults below were verified against the
# official Anthropic docs (platform.claude.com) on 2026-08-31.
# Main reasoning model — used for chat responses and tool-use decisions.
CLAUDE_MODEL_MAIN=claude-sonnet-5
# Utility model — used for cheap background tasks (memory classification, summarization).
CLAUDE_MODEL_UTILITY=claude-haiku-4-5

# ==============================
# Database (PostgreSQL / Supabase)
# ==============================
DATABASE_URL=

# ==============================
# Auth (Supabase)
# ==============================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================
# Google OAuth (Gmail + Calendar, read-only) — added in Phase 8/9
# ==============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==============================
# Secrets
# ==============================
# Encrypts OAuth refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ==============================
# Embeddings (Voyage AI) — added in Phase 5
# ==============================
# Get your key at https://dashboard.voyageai.com/
VOYAGE_API_KEY=
# Verified against Voyage AI docs on 2026-08-31: voyage-3.5 defaults to
# 1024-dimensional embeddings (configurable to 256/512/1024/2048).
VOYAGE_MODEL=voyage-3.5
VOYAGE_EMBEDDING_DIMENSION=1024

# How many long-term memories to inject into each chat request.
MEMORY_RETRIEVAL_TOP_K=5

# ==============================
# App
# ==============================
BACKEND_PORT=8000
ENVIRONMENT=development

# Temporary single-user placeholder until real authentication (Phase 11).
# Set this to your own email — it just identifies your one seeded account.
OWNER_EMAIL=owner@example.com

# Cost control: max past messages sent to Claude per chat request.
MAX_HISTORY_MESSAGES=20
